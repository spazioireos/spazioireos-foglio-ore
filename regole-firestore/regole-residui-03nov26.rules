rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===== UTENTI =====
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.uid == userId &&
        (request.resource.data.role == "worker" ||
         (request.auth.token.email == "spazioireos@gmail.com" &&
          request.resource.data.role == "admin"));
      allow read, update, delete: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
      allow read: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "viewer" &&
        userId in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.viewableWorkers;
    }

    // ===== FOGLI ORE =====
    match /timesheets/{docId} {
      allow read, write: if request.auth != null &&
        docId.matches(request.auth.uid + "__.*");
      allow read: if request.auth != null &&
        resource.data.workerUid == request.auth.uid;
      allow write: if request.auth != null &&
        request.resource.data.workerUid == request.auth.uid &&
        docId.matches(request.auth.uid + "__.*");
      allow read, write: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
      allow read: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "viewer" &&
        resource.data.workerUid in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.viewableWorkers;
      allow read: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "editor" &&
        resource.data.workerUid in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.viewableWorkers;
    }

    // ===== TETTI/CAP (solo admin) =====
    match /caps/{docId} {
      allow read, write: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }

    // ===== MASSIMALI PER SERVIZIO (svccaps) =====
    match /svccaps/{docId} {
      allow read, write: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
      allow read: if request.auth != null &&
        docId.matches(request.auth.uid + "__.*");
      allow read: if request.auth != null &&
        resource.data.workerUid == request.auth.uid;
      allow read: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "viewer" &&
        resource.data.workerUid in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.viewableWorkers;
    }

    // ===== BLOCCHI MESE (lettura a tutti gli autenticati, scrittura solo admin) =====
    match /locks/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }

    // ===== OPERATORI LIGHT (Editor gestisce i propri) =====
    match /lightsheets/{docId} {
      allow read, write: if request.auth != null &&
        (resource == null || resource.data.editorUid == request.auth.uid);
      allow create: if request.auth != null &&
        request.resource.data.editorUid == request.auth.uid;
      allow read, update, delete: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
      allow read: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "viewer" &&
        resource.data.editorUid in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.viewableLightEditors;
    }

    // ===== RESIDUI DEL TETTO ANNUO (residui) — scritti da Dipendenti, letti dal diretto interessato =====
    // Documento minimo: SOLO numeri. doc-id = uid dell'operatore in Fogli ore.
    // Scrive soltanto l'amministrazione (app Dipendenti). Legge solo il diretto interessato,
    // piu' l'amministrazione e il visualizzatore limitatamente alle persone che gli sono state assegnate.
    match /residui/{docId} {
      allow read, write: if request.auth != null &&
        request.auth.token.email == "spazioireos@gmail.com";
      allow read: if request.auth != null && docId == request.auth.uid;
      allow read: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "viewer" &&
        docId in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.viewableWorkers;
    }

    // ===== Report Ore mensile: solo l'amministrazione =====
    match /report-ore-mensile/{docId} {
      allow read, write: if request.auth != null &&
        request.auth.token.email == "spazioireos@gmail.com";
    }
  }
}
